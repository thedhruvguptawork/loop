# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# ------------------------------------------------------------------------
# Email Configuration (Choose either Resend API or Nodemailer SMTP)
# ------------------------------------------------------------------------

# OPTION 1: Resend HTTP API (RECOMMENDED for Render Free tier)
# Note: Render Free tier blocks outbound SMTP ports (25, 465, 587).
# Resend uses standard HTTPS (port 443) which is completely open and free (3,000 emails/month).
# Get a free key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Loop App <onboarding@resend.dev>

# OPTION 2: Nodemailer SMTP (Gmail / Custom SMTP)
# Works on localhost, paid Render plans, Railway, VPS, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Loop App" <your_email@gmail.com>

# ------------------------------------------------------------------------
# Interview & Demo Fallback Mode
# ------------------------------------------------------------------------
# If email delivery fails or credentials are missing, Loop gracefully displays
# the OTP on screen with a 1-click Auto-fill button, and accepts master bypass code 123456.
ALLOW_DEMO_OTP=true
DEMO_BYPASS_OTP=123456
