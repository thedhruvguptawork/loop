# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Loop App" <your_email@gmail.com>

# Interview & Demo Fallback Mode
# Set to 'true' to allow console OTP logging and master bypass code '123456'
ALLOW_DEMO_OTP=true
DEMO_BYPASS_OTP=123456
